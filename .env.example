# ---------------------------------------------------------------------------
# Service Registry de Horizon - variables de entorno
# Copia este archivo a .env y ajusta los valores si hace falta.
# En Docker/ECS se pasan como variables de entorno del contenedor.
# ---------------------------------------------------------------------------

# Puerto HTTP donde escucha el registro (por defecto 8761).
PORT=8761

# Interfaz de escucha. 0.0.0.0 es obligatorio dentro de un contenedor.
HOST=0.0.0.0

# Cada cuanto se ejecuta el health checker (ms). Por defecto 10000 (10 s).
HEALTH_CHECK_INTERVAL_MS=10000

# Tiempo maximo sin latido ni health check correcto antes de eliminar una
# instancia (ms). Por defecto 30000 (30 s). Debe ser mayor que el intervalo.
INSTANCE_TTL_MS=30000

# Timeout de cada ping HTTP del health checker (ms). Por defecto 2000.
HEALTH_CHECK_TIMEOUT_MS=2000

# Nivel de log: debug | info | warn | error | silent
LOG_LEVEL=info
